# ==============================================================================
# FastAPI / Python Production .gitignore
# ==============================================================================

# Python Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments (Crucial for FastAPI development)
.venv/
venv/
ENV/
env/
pythonenv*/

# Environment variables and secrets (Never commit your live database credentials!)
.env
.env.[a-zA-Z]*
!.env.example
.venv
pydantic_settings/

# Inline Databases / SQLite (Common for local FastAPI testing)
*.db
*.sqlite
*.sqlite3

# Testing, Coverage, and Linting
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logging (FastAPI / Uvicorn server logs)
*.log
logs/

# IDEs and Editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System files
.DS_Store
Thumbs.db
